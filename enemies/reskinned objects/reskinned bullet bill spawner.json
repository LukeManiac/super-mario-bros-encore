{
    "description":"place on blaster tile - bullet bill spawner, right-click to set homing state",
    "quadcount":1,
    "nospritesets":true,
    "resistseverything":true,
    "inedible":true,
    "freezable":true,
    "doesntunrotate":true,
    "drawback":true,
    "graphiccolor":[0,0,0,0],

    "width":1,
    "height":1,

    "quadi":1,

    "rightclick":[["checkbox",[[["enemy","reskinned bullet bill homing"]],[]],"homing?"]],
    "rightclickdefaults":["false"],
    "rightclicktypes":["bool"],
    "casesensitive":true,

    "static":true,
    "active":true,

    "category":11,
    "mask":[true,
            true,true,true,true,true,
            true,true,true,true,true,
            true,true,true,true,true,
            true,true,true,true,true,
            true,true,true,true,true,
            true,true,true,true,true,
            true],

	"autodelete":false,
    "dontplaysoundsoffscreen":true,

    "spawndelay":4,
    "enemy":"reskinned bullet bill",
    "playernear":false,
    "customtimer":[
        [0,["set","transform"],["property","dosupersize"]],
        [0,["set","transforms"],true],

        [0,["set","dt"],["property","spawndelay"]],
        [0,["subtract","dt"],1],

        [0,["set","loopline"],["property","currentcustomtimerstage"]],
        [0,["add","dt"],["property","customtimertimer"]],

        [0,["set","cox"],["property","x"]],
        [0,["set","coy"],["property","y"]],

        [0,["add","cox"],1],
        [0,["add","coy"],1],

        [0,["if","dt","<",["property","spawndelay"]],["add","currentcustomtimerstage"],3],
            [0,["subtract","dt"],["property","spawndelay"]],
            [0,["set","playsound"],["property","spawnonscreen"]],
            [0,["if","playernear","~=",true],"playsound"],

        [0,["set","customtimertimer"],0],
        [0,["set","currentcustomtimerstage"],["property","loopline"]]
    ],

    "transformsinto":"spawntoggle",
    "transformtrigger":"playernear",
    "playerneardist":1.5,

    "supersizeproperties":{
        "playernear":true,
        "transformtrigger":"playernotnear",
        "supersizeproperties":{
            "playernear":false,
            "transformtrigger":"playernear"
        }
    },

    "offsetX":8,
    "offsetY":0,
    "quadcenterX":8,
    "quadcenterY":8
}